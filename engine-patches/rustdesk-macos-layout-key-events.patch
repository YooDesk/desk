+    {
+        let key = char_value_to_key(chr);
+        if down {
+            if let Err(error) = en.key_down(key) {
+                log::warn!("Could not send embedded macOS layout key: {error}");
+            }
+        } else {
+            en.key_up(key);
+        }
+        return;
+    }
