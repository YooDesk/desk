+// LoginWindow only: retain the normal Aqua input path for all other workers.
+fn loginwindow_input() -> bool {
+    std::env::var("YOODESK_MACOS_LOGINWINDOW").as_deref() == Ok("1")
+}
+
+impl Enigo {
+    fn post_loginwindow_mouse(
+        &mut self, x: i32, y: i32, buttons: usize,
+    ) -> crate::ResultType {
+        unsafe extern "C" {
+            fn CGPostMouseEvent(point: CGPoint, update: i32, count: u32, left: i32, ...) -> i32;
+        }
+        let status = unsafe {
+            CGPostMouseEvent(
+                CGPoint::new(f64::from(x), f64::from(y)),
+                1,
+                3,
+                i32::from(buttons & 1 != 0),
+                i32::from(buttons & 2 != 0),
+                i32::from(buttons & 4 != 0),
+            )
+        };
+        if status != 0 {
+            return Err(format!("LoginWindow mouse event failed: {status}").into());
+        }
+        self.login_pointer = Some((x, y));
+        self.login_buttons = buttons;
+        Ok(())
+    }
+
+    fn post_loginwindow_scroll(x: i32, y: i32) {
+        unsafe extern "C" {
+            fn CGPostScrollWheelEvent(count: u32, vertical: i32, ...) -> i32;
+        }
+        // Same axis direction as the regular Enigo macOS mouse implementation.
+        let status = unsafe { CGPostScrollWheelEvent(2, y.saturating_neg(), x.saturating_neg()) };
+        if status != 0 {
+            log::warn!("LoginWindow scroll event failed: {status}");
+        }
+    }
+
+    fn loginwindow_mouse_button(&mut self, button: MouseButton, down: bool) -> crate::ResultType {
+        let Some((x, y)) = self.login_pointer else { return Ok(()); };
+        let bit = match button {
+            MouseButton::Left => 1,
+            MouseButton::Right => 2,
+            MouseButton::Middle => 4,
+            _ => return Err("LoginWindow mouse button is not supported".into()),
+        };
+        let buttons = if down { self.login_buttons | bit } else { self.login_buttons & !bit };
+        self.post_loginwindow_mouse(x, y, buttons)
+    }
+
+    fn post_loginwindow_key(&mut self, key: u16, down: bool) -> crate::ResultType {
+        unsafe extern "C" {
+            fn CGPostKeyboardEvent(character: u16, key: u16, down: i32) -> i32;
+        }
+        let status = unsafe { CGPostKeyboardEvent(0, key, i32::from(down)) };
+        if status != 0 {
+            return Err(format!("LoginWindow physical keyboard event failed: {status}").into());
+        }
+        if let Some(pressed) = self.login_keys.get_mut(usize::from(key)) {
+            *pressed = down;
+        }
+        Ok(())
+    }
+}
