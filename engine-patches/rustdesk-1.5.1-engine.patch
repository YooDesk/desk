+//! Headless 替换：`feature = "headless"` 时替代 `whiteboard` 模块。
+//!
+//! 白板是控制端叠加层的客户端功能；端侧只需要同名的类型与空实现，调用点保持
+//! 结构不变（与上游 `whiteboard::*` 的签名一致），行为上是无操作。
+
+use serde::{Deserialize, Serialize};
+
+/// 白板事件；与上游定义保持一致，供 `ipc::Data::Whiteboard` 等类型引用。
+#[derive(Debug, Serialize, Deserialize, Clone)]
+#[serde(tag = "t", content = "c")]
+pub enum CustomEvent {
+    /// 光标位置。
+    Cursor(Cursor),
+    /// 清空。
+    Clear,
+    /// 退出。
+    Exit,
+}
+
+/// 白板光标。
+#[derive(Debug, Serialize, Deserialize, Clone)]
+#[serde(tag = "t")]
+pub struct Cursor {
+    /// 相对 X。
+    pub x: f32,
+    /// 相对 Y。
+    pub y: f32,
+    /// 颜色（ARGB）。
+    pub argb: u32,
+    /// 按键位图。
+    pub btns: i32,
+    /// 附带文本。
+    pub text: String,
+}
+
+/// headless 不支持白板。
+pub fn is_supported() -> bool {
+    false
+}
+
+/// 当前连接的白板键；headless 恒为空。
+pub fn get_key_cursor(_conn_id: i32) -> String {
+    String::new()
+}
+
+/// 注册白板（无操作）。
+pub fn register_whiteboard(_key: String) {}
+
+/// 注销白板（无操作）。
+pub fn unregister_whiteboard(_key: String) {}
+
+/// 更新白板（无操作）。
+pub fn update_whiteboard(_key: String, _event: CustomEvent) {}
