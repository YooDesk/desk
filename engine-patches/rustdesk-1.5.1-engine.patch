index 754c491a7..262daaa91 100644
--- a/src/server/video_service.rs
+++ b/src/server/video_service.rs
@@ -1560,3 +1560,47 @@ mod tests {
         assert!(refresh_allowed(true, false, false));
     }
 }
+
+/// Register ffmpeg's software H.264/H.265 encoders with the codec selector.
+///
+/// The upstream probe only tests GPU encoders, so a host without one reports no
+/// usable encoder and falls back to VP9. Embedding hosts that must deliver H.264
+/// call this once at startup; the encoders themselves are ffmpeg's soft ones.
+pub fn register_software_encoders() {
+    use scrap::codec::EncodingUpdate;
+    use scrap::raw_hwcodec::ffmpeg_ram::CodecInfo;
+    #[cfg(feature = "hwcodec")]
+    {
+        // Two upstream naming rules meet here: ffmpeg registers the software encoder
+        // as `libx264`/`libx265`, while `scrap` derives the data format from the name
+        // by substring (`contains("h264")`). Keep both satisfied.
+        let soft = CodecInfo::soft();
+        let mut ram_encode = Vec::new();
+        // `name` is what ffmpeg opens, so it must be this build's codec name
+        // (`libx264`); scrap's format matcher is taught the same names in
+        // `format_from_mc_name`.
+        if let Some(mut info) = soft.h264.clone() {
+            info.name = "libx264".to_owned();
+            ram_encode.push(info);
+        }
+        if let Some(mut info) = soft.h265.clone() {
+            info.name = "libx265".to_owned();
+            ram_encode.push(info);
+        }
+        let config = scrap::hwcodec::HwCodecConfig {
+            signature: 0,
+            ram_encode,
+            ram_decode: Vec::new(),
+            #[cfg(feature = "vram")]
+            vram_encode: Vec::new(),
+            #[cfg(feature = "vram")]
+            vram_decode: Vec::new(),
+        };
+        scrap::hwcodec::HwCodecConfig::set(serde_json::to_string(&config).unwrap_or_default());
+        scrap::codec::Encoder::update(EncodingUpdate::Check);
+    }
+    #[cfg(not(feature = "hwcodec"))]
+    {
+        let _ = EncodingUpdate::Check;
+    }
+}
