@@ -0,0 +1,78 @@
+//! Headless 替换：`feature = "headless"` 时替代 `client` 模块中服务端会用到的常量。
+//!
+//! 端侧代码只引用登录错误文案与 Wayland 登录屏标记；客户端（控制端）的会话、
+//! IO 循环、界面接口全部不参与 headless 构建。
+//!
+//! 文案与上游 `client.rs` 保持逐字一致，避免协议层对端看到不同的错误字符串。
+
+/// 密码错误。
+pub const LOGIN_MSG_PASSWORD_WRONG: &str = "Wrong Password";
+/// 无密码访问被拒绝。
+pub const LOGIN_MSG_NO_PASSWORD_ACCESS: &str = "No Password Access";
+/// 对端离线。
+pub const LOGIN_MSG_OFFLINE: &str = "Offline";
+/// 2FA 验证码错误。
+pub const LOGIN_MSG_2FA_WRONG: &str = "Wrong 2FA Code";
+/// 需要 2FA。
+pub const REQUIRE_2FA: &str = "2FA Required";
+/// Wayland 登录屏相关标记；headless 不检测登录屏。
+pub const LOGIN_SCREEN_WAYLAND: &str = "Wayland login screen is not supported";
+
+// ---- 语音通话 / 媒体回传 ----
+//
+// 这些类型在服务端用于把控制端的语音回传给对端。headless 不承载控制端 UI，
+// 因此提供同名类型与“无操作”实现：调用点结构不变，行为上不发送任何数据。
+
+use base::message_proto::{
+    AudioFormat, AudioFrame, Message, VideoFrame, VoiceCallRequest, VoiceCallResponse,
+};
+
+/// 控制端媒体数据；与服务端字段保持一致。
+pub enum MediaData {
+    /// 视频队列信号。
+    VideoQueue,
+    /// 视频帧。
+    VideoFrame(Box<VideoFrame>),
+    /// 音频帧。
+    AudioFrame(Box<AudioFrame>),
+    /// 音频格式。
+    AudioFormat(AudioFormat),
+    /// 重置。
+    Reset,
+    /// 录屏开关。
+    RecordScreen(bool),
+}
+
+/// 媒体发送端。
+pub type MediaSender = std::sync::mpsc::Sender<MediaData>;
+
+/// 启动音频线程；headless 返回一个立即丢弃所有数据的发送端。
+pub fn start_audio_thread() -> MediaSender {
+    let (sender, receiver) = std::sync::mpsc::channel::<MediaData>();
+    // 持续排空，避免发送方阻塞；不做任何解码。
+    std::thread::spawn(move || {
+        while receiver.recv().is_ok() {}
+    });
+    sender
+}
+
+/// 语音呼叫请求消息。
+pub fn new_voice_call_request(is_connect: bool) -> Message {
+    let mut request = VoiceCallRequest::new();
+    request.is_connect = is_connect;
+    request.req_timestamp = hbb_common::get_time();
+    let mut message = Message::new();
+    message.set_voice_call_request(request);
+    message
+}
+
+/// 语音呼叫响应消息。
+pub fn new_voice_call_response(request_timestamp: i64, accepted: bool) -> Message {
+    let mut response = VoiceCallResponse::new();
+    response.accepted = accepted;
+    response.req_timestamp = request_timestamp;
+    response.ack_timestamp = hbb_common::get_time();
+    let mut message = Message::new();
+    message.set_voice_call_response(response);
+    message
+}
