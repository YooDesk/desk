new file mode 100644
index 000000000..f5f03d26e
--- /dev/null
+++ b/src/headless_ui.rs
@@ -0,0 +1,107 @@
+//! Headless 替换：`feature = "headless"` 时替代 `ui_interface` / `ui_session_interface` /
+//! `ui_cm_interface`。
+//!
+//! 嵌入本库的产品（YooDesk WebService）不使用 RustDesk 的 GUI，但端侧代码仍在几处引用
+//! UI 模块的小工具函数。这里只提供这些函数的等价实现，不引入 Sciter/tao/tray-icon 等
+//! GUI 依赖，因此链接产物里不会出现任何窗口系统代码。
+//!
+//! 语义保持与上游一致：不改变端侧行为，只去掉“展示/交互”部分。
+
+use hbb_common::config::Config;
+use hbb_common::log;
+
+/// 与上游 `ui_interface::max_encrypt_len` 一致。
+pub fn max_encrypt_len() -> usize {
+    hbb_common::config::ENCRYPT_MAX_LEN
+}
+
+/// headless 从不做纹理渲染（没有渲染后端）。
+pub fn use_texture_render() -> bool {
+    false
+}
+
+/// 读取配置项；与 `ui_interface::get_option` 同签名（`AsRef<str>`）。
+pub fn get_option<T: AsRef<str>>(key: T) -> String {
+    Config::get_option(key.as_ref())
+}
+
+/// 写入配置项；没有 UI 进程需要同步，直接落本地配置。
+pub fn set_option(key: String, value: String) {
+    Config::set_option(key, value);
+}
+
+/// 本地（不参与云端同步）配置读取。
+pub fn get_local_option(key: String) -> String {
+    crate::get_local_option(&key)
+}
+
+/// 本地配置写入。
+pub fn set_local_option(key: String, value: String) {
+    hbb_common::config::LocalConfig::set_option(key, value);
+}
+
+/// 内置（随安装包固定）配置项。
+pub fn get_builtin_option(key: &str) -> String {
+    crate::get_builtin_option(key)
+}
+
+/// API 服务器地址；与上游同义，直接由公共配置推导。
+pub fn get_api_server() -> String {
+    crate::get_api_server(
+        get_option("api-server"),
+        get_option("custom-rendezvous-server"),
+    )
+}
+
+/// headless 以“已安装”为准：服务通常以安装形态运行，且没有 UI 可提示。
+pub fn is_installed() -> bool {
+    true
+}
+
+/// 录制目录：没有 UI，就落到当前工作目录下的 `records/`。
+pub fn video_save_directory(_root: bool) -> String {
+    let dir = std::env::current_dir()
+        .map(|cwd| cwd.join("records"))
+        .unwrap_or_else(|_| std::path::PathBuf::from("records"));
+    let _ = std::fs::create_dir_all(&dir);
+    dir.to_string_lossy().into_owned()
+}
+
+/// 与上游 `ui_cm_interface::check_file_count_limit` 同语义，读取同一配置项。
+pub fn check_file_count_limit(file_count: usize) -> Result<(), String> {
+    use base::config::keys::OPTION_FILE_TRANSFER_MAX_FILES;
+    let max_files: usize = Config::get_option(OPTION_FILE_TRANSFER_MAX_FILES)
+        .parse()
+        .unwrap_or(1000);
+    if file_count > max_files {
+        let msg = format!(
+            "file transfer rejected: too many files ({file_count} files exceeds limit of {max_files})"
+        );
+        hbb_common::log::warn!("{msg}");
+        Err(msg)
+    } else {
+        Ok(())
+    }
+}
+
+/// 本机按键状态；headless 没有控制端的 enigo 实例，改用平台查询。
+pub fn key_state(key: enigo::Key) -> bool {
+    #[cfg(target_os = "windows")]
+    {
+        use winapi::um::winuser::GetKeyState;
+        let vk = match key {
+            enigo::Key::CapsLock => 0x14,
+            enigo::Key::NumLock => 0x90,
+            enigo::Key::Shift => 0x10,
+            enigo::Key::Control => 0x11,
+            enigo::Key::Alt => 0x12,
+            _ => return false,
+        };
+        unsafe { GetKeyState(vk) & 0x8000u16 as i16 != 0 }
+    }
+    #[cfg(not(target_os = "windows"))]
+    {
+        let _ = key;
+        false
+    }
+}
